# ローカル専用。値は .env.local にコピーする（Git にコミットしない）。
# Secret / service_role は置かない。VITE_ はブラウザに載る。

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 開発・デモ限定の仮管理者ログイン。公開ビルド / CI には設定しない。
VITE_ADMIN_ID=
VITE_ADMIN_PASSWORD=

# 公開環境 Supabase Auth 用（IDとメールの対応は公開される。パスワードは入れない）
VITE_ADMIN_LOGIN_ID=
VITE_ADMIN_AUTH_EMAIL=
